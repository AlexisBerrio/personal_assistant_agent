# Plantilla de configuración. Copia este archivo como `.env` y completa tus propios valores.
# `.env` NUNCA debe commitearse (ya está en .gitignore). Este archivo sí se versiona:
# es la documentación operativa mínima del proyecto — toda variable que consuma
# src/assistant_personal/config.py debe aparecer aquí, con un comentario.

# --- MongoDB ---
# Cadena de conexión completa (Atlas o instancia local). Requerida: el proceso no arranca sin ella.
MONGO_URI="mongodb+srv://usuario:password@tu-cluster.mongodb.net/?retryWrites=true&w=majority"
# Base de datos donde viven las colecciones de la app (tareas, sesiones). Única fuente de verdad
# para el nombre de la base — no la cambies en un solo repositorio sin cambiarla aquí.
MONGO_DB_NAME="personal_management"

# --- OpenAI (usado cuando LLM_PROVIDER=openai) ---
# Clave de API de OpenAI. Nunca compartas una clave real ni la pegues en un commit.
OPENAI_API_KEY="sk-proj-tu-clave-aqui"
# Modelo a usar para clasificación de intención, respuestas y extracción de perfil.
OPENAI_MODEL="gpt-4o-mini"

# --- Selección de proveedor LLM ---
# "openai" (por defecto/producción) o "ollama" (modelo local, útil para probar sin costo de API).
LLM_PROVIDER="openai"

# --- Ollama (solo se usa cuando LLM_PROVIDER=ollama) ---
# Endpoint compatible con la API de OpenAI que expone Ollama en local.
OLLAMA_BASE_URL="http://localhost:11434/v1"
# Tag del modelo ya descargado en Ollama (ver `ollama list`).
OLLAMA_MODEL="gemma4:12b"

# --- Tracing (OpenTelemetry, ítem 4.1) ---
# "true" para exportar spans a Jaeger (`docker compose up jaeger`). Apagado por defecto: no
# requiere el collector arriba para que el resto de la app funcione.
OTEL_ENABLED="false"
# Endpoint OTLP/gRPC del collector. El puerto 4317 es el que expone Jaeger en docker-compose.yml.
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
